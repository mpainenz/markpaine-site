{
  "name": "markpaine-site",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "pdf": "node scripts/render-pdf.mjs",
    "pdf:check": "node scripts/validate-pdf.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --project tsconfig.check.json",
    "test": "node --test tests/*.test.mjs",
    "test:site": "node scripts/test-site.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run pdf && npm run pdf:check && npm run test:site"
  },
  "dependencies": {
    "next": "^16.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "pdfjs-dist": "^6.4.299",
    "playwright": "^1.64.1",
    "typescript": "^5.9.0"
  }
}
