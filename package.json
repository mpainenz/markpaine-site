{
  "name": "markpaine-site",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "pdf": "node scripts/render-pdf.mjs",
    "pdf:check": "node scripts/validate-pdf.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --project tsconfig.check.json",
    "test": "node --test tests/*.test.mjs",
    "test:site": "node scripts/test-site.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run pdf && npm run pdf:check && npm run test:site"
  },
  "dependencies": {
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "pdfjs-dist": "^6.2.108",
    "playwright": "^1.54.0",
    "typescript": "^5.9.0"
  }
}
