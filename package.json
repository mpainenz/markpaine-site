{
  "name": "markpaine-site",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "pdf": "node scripts/render-pdf.mjs",
    "pdf:check": "node scripts/validate-pdf.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --project tsconfig.check.json",
    "test": "node --test tests/*.test.mjs",
    "test:site": "node scripts/test-site.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run pdf && npm run pdf:check && npm run test:site"
  },
  "dependencies": {
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.3.6",
    "pdfjs-dist": "^6.3.289",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2"
  }
}
